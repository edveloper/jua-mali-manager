# Copy to .env for local development. The real values also need to exist in the
# Vercel project settings, or production builds will have no Supabase connection.
#
# These are the publishable (anon) credentials and are safe in a browser bundle --
# row level security is what protects the data, not the secrecy of this key.
# The service role key is NOT here and must never be: it lives only in Supabase
# Edge Function secrets, where the platform injects it automatically.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Public URL of the deployed site, no trailing slash. Used for og:image, og:url
# and canonical. Must be absolute: WhatsApp will not resolve a relative og:image.
VITE_SITE_URL="https://your-site.example"
