{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/auth", "destination": "/app" },
    { "source": "/i/:token*", "destination": "/app" }
  ],
  "headers": [
    { "source": "/auth", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/i/:token*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/app", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
